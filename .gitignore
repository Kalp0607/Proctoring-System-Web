# ==========================================
# AI-Proctored Online Examination System
# Unified Root .gitignore
# ==========================================

# Dependencies
node_modules/
*/node_modules/
*/*/node_modules/
package-lock.json

# Environment Variables
.env
.env.*
*.env
!.env.example

# Build Outputs
dist/
*/dist/
*/*/dist/
build/
*/build/

# Uploaded Candidate Photos & Evidence (DO NOT COMMIT)
Web/server/uploads/*
!Web/server/uploads/.gitkeep
AI/AI-proctoring-system/violations/screenshots/*
!AI/AI-proctoring-system/violations/screenshots/.gitkeep
AI/AI-proctoring-system/data/reference/*
!AI/AI-proctoring-system/data/reference/.gitkeep

# Python Cache & Bytecode
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
env/
ENV/

# Model Weights (downloaded automatically if absent)
*.pt
*.onnx
*.engine
models/*.pt
models/*.onnx

# Logs & Temporary Files
*.log
logs/
*/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
violations/*.tmp
violations/*.log
tests/tmp/

# OS & IDE Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
